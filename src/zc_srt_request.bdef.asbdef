projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZC_SRT_Request alias Request
use etag
{
  use create;
  use update;
  use delete;

  use action closeRequest;
  use action reopenRequest;
  use action escalateRequest;
  use action assignToMe;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Comment { create; with draft; }
}

define behavior for ZC_SRT_Comment alias Comment
use etag
{
  use update;
  use delete;

  use association _Request { with draft; }
}
